{
  "name": "aoike-app",
  "packageManager": "bun@1.4.2",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3210",
    "build": "vite build",
    "preview": "bun run build && vite preview",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate --config drizzle.auth.config.ts && drizzle-kit generate --config drizzle.kintai.config.ts",
    "db:migrate": "wrangler d1 migrations apply AUTH_DB --local && wrangler d1 migrations apply KINTAI_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply AUTH_DB --remote && wrangler d1 migrations apply KINTAI_DB --remote",
    "set-password": "bun scripts/set-password.ts",
    "icons": "bun scripts/icons/make-icons.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.57.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "opentype.js": "^1.3.4",
    "shadcn": "^4.21.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.151.0"
  }
}
