/**
 * Wrangler 設定
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aoike-attendance",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat", "enable_request_signal"],
	"main": "src/worker.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * 公開URLは https://app.aoike.jp（Cloudflare for SaaS 経由で下の routes から届く）。
	 * 入口を app.aoike.jp に一本化するため、workers.dev とプレビューURLは閉じている。
	 */
	"workers_dev": false,
	"preview_urls": false,
	/**
	 * Cloudflare for SaaS（SaaS ゾーン chiji.tech）経由の入口（README の「公開URL」を参照）。
	 * app.aoike.jp を chiji.tech の Custom Hostname として登録し、ラディックスで
	 * CNAME を saas.chiji.tech に向けると、このルートで本 Worker に直接届く。
	 * カスタムホスト名への通信は chiji.tech ゾーンに入るので zone_name は chiji.tech。
	 * kintai.aoike.jp・csv.aoike.jp は、まとめる前の URL を app.aoike.jp/kintai・/csv へ転送するためだけに受けている（src/lib/legacy-host.ts）。
	 */
	"routes": [
		{
			"pattern": "app.aoike.jp/*",
			"zone_name": "chiji.tech"
		},
		{
			"pattern": "kintai.aoike.jp/*",
			"zone_name": "chiji.tech"
		},
		{
			"pattern": "csv.aoike.jp/*",
			"zone_name": "chiji.tech"
		}
	],
	/**
	 * 公開URL（Better Auth の baseURL）。秘密ではないので vars に置く。
	 * ローカルでは .dev.vars の値（http://localhost:3210）が優先される。
	 */
	"vars": {
		"BETTER_AUTH_URL": "https://app.aoike.jp"
	},
	/**
	 * 認証（ユーザー・セッション）は全ツール共通の AUTH_DB、業務データはツールごとの D1 に分ける。
	 */
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "aoike-auth",
			"database_id": "f44bf357-0eff-4899-af7a-66fd70a73e05",
			"migrations_dir": "drizzle/auth"
		},
		{
			"binding": "KINTAI_DB",
			"database_name": "aoike-attendance",
			"database_id": "16420424-eeec-41f9-9262-14818073cc6e",
			"migrations_dir": "drizzle/kintai"
		},
		{
			"binding": "CSV_DB",
			"database_name": "aoike-kensetsu-csv",
			"database_id": "4df05265-8f6d-4056-9443-0fa96a28ed5b",
			"migrations_dir": "drizzle/csv"
		},
		{
			"binding": "FIT_DB",
			"database_name": "aoike-fit",
			"database_id": "145568ed-9cf2-4e67-9ba5-efdada234804",
			"migrations_dir": "drizzle/fit"
		}
	],
	/** 工事経歴書 CSV の案件に付けたファイル（Excel・PDF・写真）と書き出したファイル */
	"r2_buckets": [
		{
			"binding": "CSV_FILES",
			"bucket_name": "aoike-kensetsu-csv-files"
		},
		/** FIT 申請の手続の書類（公開アクセスなし。ログインした人だけが Worker 経由でダウンロードする） */
		{
			"binding": "FIT_FILES",
			"bucket_name": "aoike-fit-files"
		}
	],
	/** 毎日 3:00（日本時間。cron は UTC）：FIT の書類のゴミ箱から30日たったものを消す（src/worker.ts の scheduled） */
	"triggers": {
		"crons": ["0 18 * * *"]
	},
	/** 工事経歴書 CSV の工事場所の一括調査（src/server/location-workflow.ts。src/worker.ts から出している） */
	"workflows": [
		{
			"name": "aoike-app-location-search",
			"binding": "LOCATION_SEARCH",
			"class_name": "LocationSearchWorkflow"
		}
	]
	/**
	 * Secrets（`bunx wrangler secret put <NAME>` で設定）
	 *  - BETTER_AUTH_SECRET: 32文字以上のランダム文字列
	 *  - ANTHROPIC_API_KEY:  Claude API のキー（工事経歴書 CSV。未設定でもルール変換だけで動く）
	 */
}
